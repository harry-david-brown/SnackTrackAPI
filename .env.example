# SnackTrack API Environment Variables
# Copy this file to .env and fill in your values

# ==============================================
# Server Configuration
# ==============================================
NODE_ENV=development  # development | production
PORT=3000
HOST=localhost

# ==============================================
# Database Configuration
# ==============================================
# Local PostgreSQL (default for development)
DATABASE_URL=postgresql://snacktrack:password@localhost:5432/snacktrack_dev

# ==============================================
# Redis Cache (Optional)
# ==============================================
# Local Redis (default for development)
REDIS_URL=redis://localhost:6379

# ==============================================
# Authentication & Security
# ==============================================
# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# API Key for admin endpoints
API_KEY=your-admin-api-key-change-this

# ==============================================
# Gmail Integration (NEW!)
# ==============================================
# Get these from Google Cloud Console
GMAIL_CLIENT_ID=your_google_client_id_here
GMAIL_CLIENT_SECRET=your_google_client_secret_here

# ==============================================
# Monitoring & Error Tracking
# ==============================================
SENTRY_DSN=your_sentry_dsn_here
BETTERSTACK_SOURCE_TOKEN=your_betterstack_token_here

# ==============================================
# Development & Testing
# ==============================================
LOG_LEVEL=debug
USE_MOCK_DATA=true



# OAuth Redirect URIs (Platform-specific)
WEB_REDIRECT_URI=http://localhost:8082/oauth-callback
MOBILE_REDIRECT_URI=snacktrack://oauth/callback
