# SnackTrack API Environment Variables
# Copy this file to .env and fill in your values

# ==============================================
# Server Configuration
# ==============================================
NODE_ENV=development  # development | production
PORT=3000
HOST=localhost

# ==============================================
# Database Configuration
# ==============================================
# Local PostgreSQL (default for development)
DATABASE_URL=postgresql://snacktrack:password@localhost:5432/snacktrack_dev

# ==============================================
# Redis Cache (Optional)
# ==============================================
# Local Redis (default for development)
REDIS_URL=redis://localhost:6379
QUEUE_REDIS_URL=redis://localhost:6379
MAILBOX_WORKER_CONCURRENCY=2
EXPORT_WORKER_CONCURRENCY=1
NOTIFICATION_WORKER_CONCURRENCY=10
QUEUE_MAXIMUM_WAITING_JOBS=1000

# S3-compatible import storage. Docker Compose starts MinIO with these defaults.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=snacktrack-imports
OBJECT_STORAGE_ACCESS_KEY_ID=snacktrack
OBJECT_STORAGE_SECRET_ACCESS_KEY=snacktrack-local-secret
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_UPLOAD_URL_TTL_SECONDS=900

# Use "log" locally. Set to "expo" in a configured production environment.
PUSH_DELIVERY_MODE=log

# Keep the total across API and worker replicas below the PostgreSQL plan limit.
DATABASE_POOL_MAX=8

# ==============================================
# Authentication & Security
# ==============================================
# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=use-a-different-32-character-secret-in-production

# Temporary compatibility key for legacy administrator endpoints only.
API_KEY=your-admin-api-key-change-this
# Independent key used only by external scheduler jobs.
SCHEDULER_API_KEY=your-separate-scheduler-key-change-this
# Keep false in production after operational use moves to /admin/v1 sessions.
LEGACY_ADMIN_API_KEY_ENABLED=false
# Enable only after analytics backfill and dashboard reconciliation are complete.
ANALYTICS_MAINTENANCE_ENABLED=false
ADMIN_DASHBOARD_URL=http://localhost:5173

# ==============================================
# Gmail Integration (NEW!)
# ==============================================
# Get these from Google Cloud Console
GMAIL_CLIENT_ID=your_google_client_id_here
GMAIL_CLIENT_SECRET=your_google_client_secret_here
# Conservative per-user import budget. Google's published ceiling is 6000,
# but this leaves room for other deployments and Gmail features using the same user/project.
GMAIL_IMPORT_QUERY_UNITS_PER_MINUTE=1600
GMAIL_PROJECT_QUERY_UNITS_PER_DAY=60000000
GMAIL_USER_QUERY_UNITS_PER_MINUTE=6000
GMAIL_PUSH_DEBOUNCE_SECONDS=30
# All four values are required to enable authenticated Gmail push delivery.
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/gmail-mailbox-updates
GMAIL_PUBSUB_SUBSCRIPTION=projects/your-project/subscriptions/gmail-mailbox-updates-push
GMAIL_PUBSUB_AUDIENCE=https://api.example.com/webhooks/gmail/pubsub
GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=gmail-push@your-project.iam.gserviceaccount.com

# ==============================================
# Outlook / Microsoft Graph receipt importing
# ==============================================
# Register a confidential web application that supports both organizational
# directories and personal Microsoft accounts. The redirect must point to the
# API's /outlook/callback endpoint.
MICROSOFT_MAIL_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_MAIL_CLIENT_SECRET=replace-with-an-entra-client-secret
MICROSOFT_MAIL_REDIRECT_URI=http://localhost:3000/outlook/callback
# Generate independently from JWT secrets: openssl rand -base64 32
MAILBOX_TOKEN_ENCRYPTION_KEY=replace-with-a-dedicated-32-character-secret

# Microsoft identity login uses a separate public mobile app registration.
# Leave disabled until the matching iOS and Android builds are configured.
MICROSOFT_LOGIN_CLIENT_ID=
MICROSOFT_LOGIN_ENABLED=false

# ==============================================
# Monitoring & Error Tracking
# ==============================================
SENTRY_DSN=your_sentry_dsn_here
BETTERSTACK_SOURCE_TOKEN=your_betterstack_token_here

# ==============================================
# Development & Testing
# ==============================================
LOG_LEVEL=debug
USE_MOCK_DATA=true



# OAuth Redirect URIs (Platform-specific)
WEB_REDIRECT_URI=http://localhost:8082/oauth-callback
MOBILE_REDIRECT_URI=snacktrack://oauth/callback

# Historical investments: enable refresh only after verifying Finazon plan rights and coverage.
FINAZON_API_KEY=
MARKET_HISTORY_REFRESH_ENABLED=false
HISTORICAL_INVESTMENTS_ENABLED=false
