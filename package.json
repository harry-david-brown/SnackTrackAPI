{
  "name": "snack-track-express",
  "version": "1.0.0",
  "description": "Express.js/TypeScript migration of SnackTrackAPI",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "check:architecture": "node scripts/check-architecture.js",
    "check:core-coverage": "node scripts/check-core-coverage.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.js\" \"scripts/**/*.js\" \"docs/**/*.md\" \"*.json\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.js\" \"scripts/**/*.js\" \"docs/**/*.md\" \"*.json\" \".github/**/*.yml\"",
    "migrate": "npm run build && node dist/scripts/migrate.js",
    "test": "npm run build && node --test test/*.test.js",
    "start": "node dist/index.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@logtail/node": "^0.5.6",
    "@logtail/winston": "^0.5.6",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^10.19.0",
    "@types/multer": "^2.0.0",
    "@types/yauzl": "^2.10.3",
    "adm-zip": "^0.6.0",
    "apple-signin-auth": "^2.0.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.1.0",
    "express-slow-down": "^3.0.0",
    "google-auth-library": "^10.5.0",
    "googleapis": "^178.0.0",
    "helmet": "^8.1.0",
    "html-entities": "^2.6.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^9.1.0",
    "p-limit": "^3.1.0",
    "pg": "^8.11.3",
    "redis": "^5.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.1",
    "winston": "^3.10.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/express-rate-limit": "^5.1.3",
    "@types/express-serve-static-core": "^5.0.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.4.2",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.10.9",
    "@types/redis": "^4.0.10",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^9.0.2",
    "eslint": "9.39.5",
    "node-fetch": "^3.3.2",
    "prettier": "3.9.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "8.69.0"
  }
}
